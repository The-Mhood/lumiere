# Lumière environment — copy to `.env` and adjust.
#
# Database: leave DATABASE_URL unset to run embedded (PGlite, stored in
# ./.lumiere-data — no server needed, used by the desktop app). Set it to a
# PostgreSQL URL for web deployments:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Embedded DB location (desktop shell sets this to the OS user-data dir):
# LUMIERE_DATA_DIR=./.lumiere-data
#
# Auth (required in production, min 32 random chars):
AUTH_SECRET=replace-with-a-long-random-string
#
# Set to "true" when serving over HTTPS (web production). Leave unset for
# local dev and the desktop app (served over http://127.0.0.1):
# COOKIE_SECURE=true
#
# Optional: Redis-compatible cache (default is in-memory TTL cache)
# REDIS_URL=redis://localhost:6379
#
# Aggregators
# TMDB_API_KEY=            # enables "where to watch" across Netflix/Prime/Apple TV/Disney+ (JustWatch data)
# TMDB_REGIONS=PK,US,GB,IN
# AGGREGATOR_TOKEN=        # if set, POST /api/aggregate/sync requires `Authorization: Bearer <token>`
# CINEJOY_RENDERED_HTML=   # path to browser-rendered catalogue snapshot, not a stream feed
# NEXT_ALLOWED_DEV_ORIGINS= # comma-separated preview hostnames for Next.js development HMR
#
# Live discovery (metadata only; choose one credential, kept server-side)
# TMDB_READ_ACCESS_TOKEN=
# TMDB_WATCH_REGION=NG
#
# On-demand media scraper: run `npm run media:worker` separately with Chromium.
# Both Next and the worker need the same random secret (at least 24 characters).
# LUMIERE_MEDIA_WORKER_URL=http://127.0.0.1:3200
# LUMIERE_MEDIA_WORKER_TOKEN=
# MEDIA_WORKER_PORT=3200
# Optional site-adapter config path (default scrapers/sites.json):
# LUMIERE_SCRAPER_SITES=
# Optional JSON array overriding the app's matching provider/host allowlists:
# LUMIERE_SCRAPER_PROVIDERS=
# Optional preinstalled Chromium executable for the worker:
# CHROMIUM_EXECUTABLE_PATH=
#
# Production deployment: see deploy/README.md. `npm run deploy:configure`
# generates private deploy/.env secrets. That file is never committed.
# LUMIERE_DOMAIN=watch.example.com
# Optional PUBLIC desktop build-time origin (not a token):
# LUMIERE_DESKTOP_SERVER_URL=https://watch.example.com
# Demo data is opt-in for tests only; keep unset in production:
# LUMIERE_SEED_DEMOS=1
